// ─── بيانات التقرير (global للـ export) ─────────────
window._attTrackerData = [];

// ─── توليد التقرير ───────────────────────────────────
window.loadAttendanceTracker = async function () {
  const from = document.getElementById('att-from')?.value;
  const to   = document.getElementById('att-to')?.value;
  const body = document.getElementById('att-tracker-body');

  if (!from || !to) {
    if (body) body.innerHTML = '<p style="color:#dc2626;text-align:center;">⚠️ Please select both From and To dates.</p>';
    return;
  }

  if (body) body.innerHTML = '<p style="text-align:center;color:#6b7280;padding:30px;">⏳ Loading data...</p>';

  try {
    // 1. كل الموظفين
    const { data: users, error: usersErr } = await window.sb
      .from('profiles')
      .select('id, full_name, email, role')
      .not('role', 'in', '("inactive","suspended","long_leave")');

    if (usersErr) throw usersErr;

    // 2. aux_sessions في الفترة — ده الجدول الفعلي اللي بيسجّل الحضور
    const toDateEnd = to + 'T23:59:59Z';
    const fromDateStart = from + 'T00:00:00Z';

    const { data: sessions, error: sessErr } = await window.sb
      .from('aux_sessions')
      .select('*')
      .gte('date', from)
      .lte('date', to)
      .order('start_time', { ascending: true });

    if (sessErr) throw sessErr;

    // 3. السكادول
    const { data: schedules } = await window.sb
      .from('schedules')
      .select('*')
      .gte('date', from)
      .lte('date', to);

    // 4. الإجازات المعتمدة
    const { data: leaves } = await window.sb
      .from('leaves')
      .select('*')
      .eq('status', 'Approved')
      .lte('start_date', to)
      .gte('end_date', from);

    // ─── بناء الخرائط ───────────────────────────────
    // sessions مجمّعة بـ user_id + date
    const sessionsByUserDate = {};
    (sessions || []).forEach(s => {
      const key = `${s.user_id}_${s.date}`;
      if (!sessionsByUserDate[key]) sessionsByUserDate[key] = [];
      sessionsByUserDate[key].push(s);
    });

    // سكادول مجمّع بـ email + date
    const schedMap = {};
    (schedules || []).forEach(s => { schedMap[`${s.email}_${s.date}`] = s; });

    // إجازات — set بـ user_id + date
    const leaveSet = new Set();
    (leaves || []).forEach(lv => {
      let d   = new Date(lv.start_date);
      const e = new Date(lv.end_date);
      while (d <= e) {
        leaveSet.add(`${lv.user_id}_${d.toISOString().split('T')[0]}`);
        d.setDate(d.getDate() + 1);
      }
    });

    // ─── توليد الصفوف ────────────────────────────────
    const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    const rows = [];

    let cur = new Date(from);
    const endDate = new Date(to);

    const LOGIN_TYPES = ['online', 'meeting', 'training', 'coaching'];

    while (cur <= endDate) {
      const dateStr = cur.toISOString().split('T')[0];
      const dayName = days[cur.getDay()];

      (users || []).forEach(u => {
        const sched     = schedMap[`${u.email}_${dateStr}`];
        const isOnLeave = leaveSet.has(`${u.id}_${dateStr}`);
        const isOffDay  = sched && (sched.off_day1 === dayName || sched.off_day2 === dayName);
        const daySess   = sessionsByUserDate[`${u.id}_${dateStr}`] || [];

        const name = u.full_name || u.email || 'Unknown';

        if (isOnLeave) {
          rows.push({ name, date: dateStr, day: dayName, firstLogin: '—', lastLogout: '—', loginHours: '—', lateBy: '—', status: '🏖️ On Leave' });
          return;
        }

        if (isOffDay) {
          rows.push({ name, date: dateStr, day: dayName, firstLogin: '—', lastLogout: '—', loginHours: '—', lateBy: '—', status: '📴 Day Off' });
          return;
        }

        // فلتر: فقط السيشنز اللي مش offline
        const activeSess = daySess.filter(s => s.aux_type !== 'offline');

        if (activeSess.length === 0) {
          rows.push({ name, date: dateStr, day: dayName, firstLogin: '—', lastLogout: '—', loginHours: '—', lateBy: '—', status: '❌ Absent' });
          return;
        }

        // أول دخول وآخر خروج
        const allStarts  = activeSess.map(s => s.start_time).filter(Boolean).sort();
        const allEnds    = activeSess.map(s => s.end_time).filter(Boolean).sort();
        const firstLogin = allStarts[0];
        const lastLogout = allEnds[allEnds.length - 1] || null;

        // ساعات الشغل = مجموع duration_seconds لسيشنز غير break (باستثناء المفتوحة)
        let loginSec = 0;
        activeSess.forEach(s => {
          if (LOGIN_TYPES.includes(s.aux_type)) {
            if (s.duration_seconds) {
              loginSec += s.duration_seconds;
            } else if (s.end_time && s.start_time) {
              loginSec += Math.round((new Date(s.end_time) - new Date(s.start_time)) / 1000);
            }
          }
        });

        // التأخير — بتوقيت مصر
        let lateBy = '—';
        let status = '✅ Attended';

        if (sched?.shift_start && firstLogin) {
          const [sh, sm]    = sched.shift_start.split(':').map(Number);
          const schedMins   = sh * 60 + sm;
          const egFirst     = toEgyptTime(firstLogin);
          const actualMins  = egFirst.getHours() * 60 + egFirst.getMinutes();
          const diffMins    = actualMins - schedMins;

          if (diffMins > 5) {
            lateBy = fmtMins(diffMins);
            status = `⚠️ Late (+${lateBy})`;
          }
        }

        rows.push({
          name,
          date: dateStr,
          day: dayName,
          firstLogin:  toEgyptTimeStr(firstLogin),
          lastLogout:  lastLogout ? toEgyptTimeStr(lastLogout) : '—',
          loginHours:  fmtMins(loginSec / 60),
          lateBy,
          status
        });
      });

      cur.setDate(cur.getDate() + 1);
    }

    window._attTrackerData = rows;

    if (!rows.length) {
      body.innerHTML = '<p style="text-align:center;color:#9ca3af;padding:30px;">No data found for this period.</p>';
      return;
    }

    // ─── إحصائيات سريعة ─────────────────────────────
    const totalRows   = rows.length;
    const attended    = rows.filter(r => r.status.includes('Attended')).length;
    const late        = rows.filter(r => r.status.includes('Late')).length;
    const absent      = rows.filter(r => r.status.includes('Absent')).length;
    const onLeave     = rows.filter(r => r.status.includes('On Leave')).length;

    body.innerHTML = `
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
        <div class="stat-card" style="flex:1;min-width:100px;background:#f0fdf4;border-radius:8px;padding:12px;text-align:center;">
          <div style="font-size:22px;font-weight:700;color:#16a34a;">${attended}</div>
          <div style="font-size:12px;color:#6b7280;">✅ Attended</div>
        </div>
        <div class="stat-card" style="flex:1;min-width:100px;background:#fffbeb;border-radius:8px;padding:12px;text-align:center;">
          <div style="font-size:22px;font-weight:700;color:#d97706;">${late}</div>
          <div style="font-size:12px;color:#6b7280;">⚠️ Late</div>
        </div>
        <div class="stat-card" style="flex:1;min-width:100px;background:#fff5f5;border-radius:8px;padding:12px;text-align:center;">
          <div style="font-size:22px;font-weight:700;color:#dc2626;">${absent}</div>
          <div style="font-size:12px;color:#6b7280;">❌ Absent</div>
        </div>
        <div class="stat-card" style="flex:1;min-width:100px;background:#f0f9ff;border-radius:8px;padding:12px;text-align:center;">
          <div style="font-size:22px;font-weight:700;color:#0284c7;">${onLeave}</div>
          <div style="font-size:12px;color:#6b7280;">🏖️ On Leave</div>
        </div>
      </div>
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Agent</th>
              <th>Date</th>
              <th>Day</th>
              <th>First Login <small style="font-weight:400;color:#9ca3af;">(EG)</small></th>
              <th>Last Logout <small style="font-weight:400;color:#9ca3af;">(EG)</small></th>
              <th>Login Hours</th>
              <th>Late By</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            ${rows.map(r => {
              const bg =
                r.status.includes('Absent')  ? 'background:#fff5f5;' :
                r.status.includes('Late')    ? 'background:#fffbeb;' :
                r.status.includes('On Leave')? 'background:#f0f9ff;' :
                r.status.includes('Day Off') ? 'background:#f9fafb;' : '';
              return `
                <tr style="${bg}">
                  <td><strong>${r.name}</strong></td>
                  <td>${r.date}</td>
                  <td style="color:#6b7280;font-size:12px;">${r.day}</td>
                  <td><strong>${r.firstLogin}</strong></td>
                  <td>${r.lastLogout}</td>
                  <td>${r.loginHours}</td>
                  <td style="color:${r.lateBy !== '—' ? '#dc2626' : '#9ca3af'};">${r.lateBy}</td>
                  <td>${r.status}</td>
                </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>`;

  } catch (e) {
    console.error('loadAttendanceTracker error:', e);
    if (body) body.innerHTML = `<p style="color:#dc2626;text-align:center;">❌ Error: ${e.message}</p>`;
  }
};

// ─── تصدير CSV ───────────────────────────────────────
window.exportAttendanceTracker = function () {
  const rows = window._attTrackerData || [];
  if (!rows.length) { alert('Generate the report first.'); return; }

  const from = document.getElementById('att-from')?.value || '';
  const to   = document.getElementById('att-to')?.value   || '';

  const headers = ['Agent','Date','Day','First Login (EG)','Last Logout (EG)','Login Hours','Late By','Status'];
  const csv = [
    headers.join(','),
    ...rows.map(r => [
      `"${r.name}"`, r.date, r.day,
      r.firstLogin, r.lastLogout,
      `"${r.loginHours}"`, `"${r.lateBy}"`, `"${r.status}"`
    ].join(','))
  ].join('\n');

  const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = `Attendance_Tracker_${from}_${to}.csv`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
};

// ─── تشغيل عند APP_READY ─────────────────────────────
document.addEventListener('APP_READY', () => {
  const role = (APP.userRole || '').toLowerCase();
  if (['admin', 'supervisor', 'owner', 'upper_management'].includes(role)) {
    window.buildAttendanceTrackerPanel();
  }
});
